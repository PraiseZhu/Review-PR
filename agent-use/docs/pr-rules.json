{
  "_comment": "本仓的完整 review-pr 配置。以分发版中性默认值为基线，仅保留本仓 preview-dist/ 生成物的 size-gate 排除项。",
  "titleTypes": [
    "feat",
    "fix",
    "refactor",
    "perf",
    "chore",
    "docs",
    "test",
    "revert",
    "build",
    "ci"
  ],
  "lightTypes": [
    "chore",
    "docs",
    "test",
    "build",
    "ci",
    "revert"
  ],
  "featureSections": [
    "这次改了什么",
    "怎么验证的",
    "风险"
  ],
  "bugfixSections": [
    "这次改了什么",
    "怎么验证的",
    "风险"
  ],
  "checklistSectionNames": [
    "self-review"
  ],
  "redlinePaths": [
    "updater",
    "localDb/schema\\.ts",
    "drizzle/"
  ],
  "serverPaths": [],
  "ciSensitivePaths": [
    "\\.github/workflows/",
    "\\.github/actions/"
  ],
  "sensitiveContent": {
    "allowPaths": [],
    "extraHardPatterns": [],
    "extraSoftPatterns": []
  },
  "productWhitelist": [],
  "uiPaths": [
    "apps/desktop/src/renderer/",
    "apps/mobile/",
    "docs/design-rules/cindy-design-system.md"
  ],
  "uiExcludePaths": [
    "apps/desktop/src/renderer/i18n/locales/",
    "apps/mobile/src/i18n/locales/",
    "**/*.test.ts",
    "**/*.test.tsx",
    "**/*.spec.ts",
    "**/*.spec.tsx",
    "**/__tests__/**"
  ],
  "archGate": {
    "whitelist": [],
    "corePaths": [
      "packages/",
      "cindy-protocol/",
      "apps/desktop/src/main/",
      "apps/desktop/src/preload/",
      "apps/desktop/src/shared/"
    ],
    "coreDiffLines": 150,
    "refactorDiffLines": 400,
    "anyTypeDiffLines": 800,
    "coldUpdatePaths": [
      "apps/mobile/app.json",
      "apps/mobile/app.config.js",
      "apps/mobile/eas.json",
      "apps/mobile/package.json",
      "apps/mobile/fingerprint.config.cjs",
      "apps/mobile/plugins/",
      "apps/mobile/modules/",
      "scripts/shared/client-endpoint-build-env.cjs"
    ],
    "coldUpdateGuardMarker": "<!-- mobile-fingerprint-guard -->",
    "coldUpdateApprovers": []
  },
  "slackSyncBots": [],
  "slackSenderAliases": {},
  "feishuNotify": {
    "groupName": "",
    "archRecipientName": "",
    "orgMappingRepos": []
  },
  "staleAuthorReminder": {
    "idleHours": 24,
    "repeatHours": 24,
    "exemptAuthors": [],
    "crossChannelSuppressHours": 24
  },
  "selfFixAuthors": [],
  "admins": [],
  "mergeAuthorization": {
    "breakGlassApprovers": [],
    "requireAutomatedReviewForAutoMerge": false
  },
  "structuralBypassAllowlist": [
    "code_scanning",
    "code_quality"
  ],
  "securityReviewPaths": [],
  "ruleFiles": {
    "required": [],
    "uiRequired": [],
    "ruleMap": null
  },
  "summaryBroadcast": {
    "command": null
  },
  "loopPrExclusion": null,
  "prescan": {
    "enabled": false
  },
  "reviewSegments": {
    "sizeBudget": 60,
    "sizeBudgetBytes": 50000
  },
  "sizeGate": {
    "_comment": "消费方=pr-autopilot scripts/size-gate.mjs（从 merge-base 树读本字段，故本文件合入 main 后才对后续 PR 生效）。excludePaths 只加仓库特有项：preview-dist/ 与 dist/ 是同一份 build-dist.mjs 生成、随源重建的构建产物镜像，dist/ 已在 size-gate 内置排除列表，本项使 preview-dist/ 与其对齐——不占人工审查预算，与 mivo 仓 sizeGate 已确立的「生成产物不占预算」原则一致。不调 budgetLines/warnRatio，保持默认 800/0.75。",
    "excludePaths": [
      "^preview-dist/"
    ]
  }
}
