{
  "verify": {
    "mode": "enforce",
    "model": "openai/gpt-6.1-sol",
    "effort": "medium",
    "tiers": ["standard", "heavy"],
    "maxFindings": 3,
    "perCallTimeoutMin": 15,
    "budgetMin": 20
  },
  "handoff": {
    "mode": "observe"
  },
  "specChange": {
    "forceFull": false
  },
  "focus": {
    "ciCovered": [
      "npx tsc -b",
      "npm run lint",
      "npm run test:unit",
      "npm run test:server-pg",
      "npm run verify:logging",
      "npm run verify:i18n",
      "npm run verify:design",
      "node scripts/ci/structure-guard.mjs",
      "node scripts/ci/cycle-guard.mjs",
      "gitleaks"
    ]
  }
}
