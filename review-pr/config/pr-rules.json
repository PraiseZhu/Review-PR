  "ciIgnoreWorkflows": {
    "_comment": "不算作者 CI 的 workflow:新审查流程自己的 review-pr.yml,以及切换后退役的旧三席 code-review.yml(其历史结果留在旧 head 上,不能再拦 PR)。names 对 statusCheckRollup 的 workflowName,paths 对 actions/runs 的 path。",
    "names": [
      "review-pr",
      "Code Review"
    ],
    "paths": [
      ".github/workflows/review-pr.yml",
      ".github/workflows/code-review.yml"
    ]
  },
  "reviewOnlyNotices": "auto",
  "sensitiveContent": {
    "allowPaths": [
      "^src/__tests__/",
      "^cindyplugin/src/__tests__/"
    ],
    "extraHardPatterns": [],
    "extraSoftPatterns": []
  },
  "maintainerAllowlist": [
    "PraiseZhu",
    "kirozeng",
    "aj0928"
  ],
  "selfFixAuthors": [],
  "protectedPaths": {
    "_comment": "受保护路径:命中即不自动审查、不自动放行,交人工处理。contact 是作者提醒里点名的人工处理人。",
    "paths": [
      ".github/",
      "CODEOWNERS",
      "docs/CODEOWNERS"
    ],
    "contact": {
      "login": "PraiseZhu",
      "name": "PraiseZhu",
      "pronoun": "他"
    }
  },
  "signoffGate": {
    "label": "awaiting-discussion",
    "exemptAuthors": [
      "PraiseZhu",
      "kirozeng",
      "aj0928",
      "zhongxingtian-ai"
    ],
    "slackRelease": {
      "_comment": "Slack 讨论串回复「同意放行」视为放行。可信条件同时满足:评论作者在 slackSyncBots 且正文带 slack-inbound 标记;署名 @login 在维护者集合内且不是 PR 作者;回复正文有一整行是 consentLine,且没有否定词。",
      "enabled": true,
      "consentLine": "同意放行"
    },
    "issueCommentRelease": {
      "_comment": "维护者直接在确认 issue 下评论「同意放行」视为放行(2026-10-16 维护者确认新规则):评论人在维护者集合内且不是 PR 作者;正文有一整行是 slackRelease.consentLine 且没有否定词;带流程标记或被折叠的评论不算;issue 必须是本 PR 的确认 issue 且不是通知 issue。批一次一直有效。",
      "enabled": true
    },
    "product": {
      "_comment": "Mivo 不让改界面的 PR 等维护者确认(enabled=false,feat 类型同样不触发);改界面只要求作者在描述里附截图/录屏或 HTML 界面。requireUiEvidence=non-admin:对仓库没有 admin 权限的作者缺证据按格式门打回(维护者 2026-10-15 决定:admin 不需要截图),作者权限读不到时按要证据处理。acceptNotApplicable=true:作者在「效果展示」第一行写「不涉及」也算过(维护者 2026-10-12 决定),是否属实由服务器审查判。uiPaths / uiExcludePaths 只用于判定是否改了界面。",
      "enabled": false,
      "requireUiEvidence": "non-admin",
      "acceptNotApplicable": true,
      "uiPaths": [
        "cindyplugin/",
        "src/",
        "public/",
        "index.html"
      ],
      "uiExcludePaths": [
